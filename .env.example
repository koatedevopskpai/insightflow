# Copy to .env and adjust. Never commit .env.
#
# MLflow tracking backend: local SQLite by default.
# Swap for a remote server (or Databricks workspace) without code changes.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Registered model to serve (Production stage).
MLFLOW_MODEL_URI=models:/Insightflow California Housing/production

# FastAPI server
PORT=8000
